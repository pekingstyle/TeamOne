<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cn.teamone</groupId>
    <artifactId>teamone-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>teamone-collab</artifactId>
  <name>TeamOne :: Collab</name>
  <description>团队协同域：会话/消息/话题/通知/在线状态（M1 实现，见架构设计 §6.2/§9）</description>
  <dependencies>
    <dependency>
      <groupId>cn.teamone</groupId>
      <artifactId>teamone-shared</artifactId>
    </dependency>
    <!-- W3-③b: NotificationController 登录态取 @AuthenticationPrincipal AppUser（platform 域实体）；
         红线：collab 禁 import prd/eng（ArchUnit R4），platform 单向依赖允许（§1.4） -->
    <dependency>
      <groupId>cn.teamone</groupId>
      <artifactId>teamone-platform</artifactId>
    </dependency>
    <!-- W3-③b: 实体/仓库（JPA）+ ConversationService 延迟归档 ZSET（StringRedisTemplate） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- W3-③b: MessageService 幂等/成员/归档 纯逻辑单测（mock 仓库） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
