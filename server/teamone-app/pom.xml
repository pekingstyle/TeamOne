<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cn.teamone</groupId>
    <artifactId>teamone-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <properties>
    <!-- 迟绑定缺省（surefire @{argLine} 要求属性存在；平台流水线经 -DargLine 注入 JaCoCo agent 时覆盖） -->
    <argLine></argLine>
  </properties>
  <artifactId>teamone-app</artifactId>
  <name>TeamOne :: App</name>
  <description>Boot 装配：安全/Flyway/WS 端点/切面/种子数据</description>

  <dependencies>
    <dependency><groupId>cn.teamone</groupId><artifactId>teamone-shared</artifactId></dependency>
    <dependency><groupId>cn.teamone</groupId><artifactId>teamone-platform</artifactId></dependency>
    <dependency><groupId>cn.teamone</groupId><artifactId>teamone-prd</artifactId></dependency>
    <dependency><groupId>cn.teamone</groupId><artifactId>teamone-collab</artifactId></dependency>
    <dependency><groupId>cn.teamone</groupId><artifactId>teamone-eng</artifactId></dependency>
    <dependency><groupId>cn.teamone</groupId><artifactId>teamone-insight</artifactId></dependency>

    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-websocket</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-aop</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <!-- W1: Valkey（Redis 协议兼容）——ACL 决策缓存 / 刷新令牌存储 / W3 起的 Outbox Stream 扇出 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>
    <!-- M3-INC-1 (V-17): 生产监控与指标采集 (Prometheus) -->
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
    <!-- W1: OpenAPI 契约（架构设计 §3.3：字段级契约由 springdoc 生成） -->
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId></dependency>

    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>

    <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId></dependency>
    <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId></dependency>
    <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId></dependency>

    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <!-- W1: 模块依赖纪律的强制载体（架构设计 §1.4） -->
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId></dependency>
    <!-- W1: 集成测试回归网（Testcontainers PG17；本地无 Docker 自动跳过，CI 内 -DskipITs=false 启用） -->
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId></dependency>
  </dependencies>

  <build>
    <finalName>teamone-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- 集成测试：*IT.java 由 failsafe 在 verify 阶段执行；skipITs 默认 true（本地无 Docker），
           CI 传 -DskipITs=false 打开。单测/ArchUnit 走 surefire 不受影响。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <skipITs>${skipITs}</skipITs>
          <!-- IT 容器化执行（WSL docker.sock / CI）时 Mockito inline MockMaker 需要
               允许 byte-buddy 自附着，否则报 "JDK does not supply a working agent
               attachment mechanism"；-XX:+EnableDynamicAgentLoading 兼容新 JDK 提示 -->
          <!-- @{argLine} 迟绑定：把命令行 -DargLine（平台流水线注入的 JaCoCo agent）拼在
               自有参数前——硬编码会整体覆盖注入导致覆盖率数据丢失（⑥l E2E 实证踩坑） -->
          <argLine>@{argLine} -Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
