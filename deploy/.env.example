# 复制为 .env 并填入真实值（真实 .env 已被 .gitignore 排除，严禁提交）
# 数据库（外部 PostgreSQL）
TEAMONE_DB_URL=jdbc:postgresql://<host>:<port>/teamone
TEAMONE_DB_USER=<user>
TEAMONE_DB_PASSWORD=<password>
# 应用
TEAMONE_JWT_SECRET=<random-32+chars>
SERVER_PORT=8080
# Valkey（W1 起；未启动时服务可跑，ACL 缓存自动降级直查）
TEAMONE_VALKEY_HOST=localhost
TEAMONE_VALKEY_PORT=6379
# 刷新令牌存储：jpa（兜底）| redis（Valkey 可达时推荐）
#TEAMONE_REFRESH_STORE=redis
# 自研 Git 内核（D-2026-09-11-B）：bare repo 根目录 + post-receive 回调共享口令
TEAMONE_GIT_ROOT=<如 C:/Users/<you>/Workspace/gitrepos>
TEAMONE_HOOK_TOKEN=<random-40+chars>
#TEAMONE_HOOK_URL=http://localhost:8080/api/v1/git/hooks/post-receive
# MinIO（INC-2 文件两步制；compose minio 服务与后端 MinioPort 共用以下键）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=teamone-dev
# nginx TLS+WSS 反代目标（INC-2 T-6）：host 网络容器内 localhost=WSL 自身，禁 localhost；
# 填 Windows 宿主 LAN IP（ip route 查 R3 网关侧地址，W1 预检已证通 192.168.2.101）
#TEAMONE_BACKEND_ORIGIN=http://192.168.2.101:8080
# 消息撤回时间窗（小时；缺省 24，测试撤旧消息可配 0=不限窗）
#TEAMONE_IM_WITHDRAW_WINDOW_HOURS=24
